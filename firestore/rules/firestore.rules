rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid) && request.resource.data.accountStatus == 'active';
      allow update: if owns(uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus', 'uid', 'createdAt']));
      allow delete: if false;

      match /preferences/{kind} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && kind in ['settings', 'service', 'notifications'];
        allow delete: if owns(uid) && kind in ['settings', 'service', 'notifications'];
      }
      match /privacy/{kind} {
        allow read: if owns(uid);
        allow write: if owns(uid) && kind == 'security';
      }
      match /privacy/consents/{consentId} {
        allow read: if owns(uid);
        allow write: if false;
      }
      match /addresses/{addressId} {
        allow read, create, update, delete: if owns(uid);
      }
      match /savedPlaces/{placeId} {
        allow read, create, update, delete: if owns(uid);
      }
      match /devices/{deviceId} {
        allow read, create, update, delete: if owns(uid);
      }
      match /favorites/{favoriteId} {
        allow read, create, update, delete: if owns(uid);
      }
      match /paymentMethods/{methodId} {
        allow read: if owns(uid);
        allow write: if false;
      }
      match /orders/{orderId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid);
        allow delete: if false;
      }
      match /walletTransactions/{entryId} {
        allow read: if owns(uid);
        allow write: if false;
      }
      match /{nested=**} { allow read, write: if false; }
    }

    match /catalogRestaurants/{restaurantId} {
      allow read: if resource.data.active == true;
      allow write: if isAdmin();
      match /menuItems/{itemId} {
        allow read: if get(/databases/$(database)/documents/catalogRestaurants/$(restaurantId)).data.active == true
          && resource.data.available == true;
        allow write: if isAdmin();
      }
    }
    match /catalogFoodBanners/{bannerId} {
      allow read: if resource.data.active == true;
      allow write: if isAdmin();
    }
    match /catalogGroceryCategories/{categoryId} {
      allow read: if resource.data.active == true;
      allow write: if isAdmin();
    }
    match /catalogGroceryProducts/{productId} {
      allow read: if resource.data.isAvailable == true;
      allow write: if isAdmin();
    }
    match /catalogGroceryOffers/{offerId} {
      allow read: if resource.data.active == true;
      allow write: if isAdmin();
    }
    match /catalogServiceProviders/{providerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /catalogHomeCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /catalogHomeServices/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /catalogHomeBanners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /catalogPharmacies/{pharmacyId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
      match /inventory/{medicineId} {
        allow read: if resource.data.active == true || isAdmin();
        allow write: if isAdmin();
      }
    }
    match /catalogMedicines/{medicineId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /catalogSearchProjections/{projectionId} {
      allow read: if (resource.data.active == true && resource.data.searchable == true) || isAdmin();
      allow write: if isAdmin();
    }
    match /serviceCatalog/{serviceId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /healthcareSpecialties/{specialtyId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /catalogHospitals/{hospitalId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
      match /departments/{departmentId} {
        allow read: if resource.data.active == true || isAdmin();
        allow write: if isAdmin();
      }
      match /doctors/{doctorId} {
        allow read: if resource.data.active == true || isAdmin();
        allow write: if isAdmin();
        match /availability/{slotId} {
          allow read: if resource.data.active == true || resource.data.bookable == true || resource.data.status == 'available' || isAdmin();
          allow write: if false;
        }
      }
    }

    match /carts/{cartId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      match /items/{itemId} {
        function ownsCart() {
          return signedIn() && get(/databases/$(database)/documents/carts/$(cartId)).data.userId == request.auth.uid;
        }
        allow read, create, update, delete: if ownsCart();
      }
    }

    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
      match /{nested=**} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }
    match /rides/{rideId} {
      // 1. Read: The rider (or guest tester) can view this ride
      allow read: if (signedIn() && resource.data.userId == request.auth.uid)
        || resource.data.userId == 'guest_user';

      // 2. Direct client writes forbidden per Greenfield Section 5:
      // "No client screen should be wired to direct writes for orders, payment, wallet, inventory,
      // appointment status, ride assignment, email, audit, or any other privileged state."
      // All ride creation, cancellation, status transitions, and ratings are strictly managed by trusted Cloud Functions.
      allow write: if false;

      // 3. Subcollections (e.g. events)
      match /{nested=**} {
        allow read: if (signedIn() && get(/databases/$(database)/documents/rides/$(rideId)).data.userId == request.auth.uid)
          || get(/databases/$(database)/documents/rides/$(rideId)).data.userId == 'guest_user';
        allow write: if false;
      }
    }
    match /serviceBookings/{bookingId} {
      allow read: if (signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      )) || resource.data.userId in ['guest_user', 'sample_user'];
      allow write: if false;
      match /events/{eventId} {
        allow read: if (signedIn() && (
          get(/databases/$(database)/documents/serviceBookings/$(bookingId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/serviceBookings/$(bookingId)).data.providerId == request.auth.uid ||
          isAdmin()
        )) || get(/databases/$(database)/documents/serviceBookings/$(bookingId)).data.userId in ['guest_user', 'sample_user'];
        allow write: if false;
      }
    }
    match /hospitalAppointments/{appointmentId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
      match /events/{eventId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/hospitalAppointments/$(appointmentId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }
    match /prescriptions/{prescriptionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
      match /items/{itemId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/prescriptions/$(prescriptionId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }
    match /medicalDocuments/{documentId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;

      match /refunds/{refundId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/payments/$(paymentId)).data.userId == request.auth.uid;
        allow write: if false;
      }
    }
    match /paymentProviderEvents/{eventId} { allow read, write: if false; }
    match /auditEvents/{eventId} { allow read, write: if false; }
    match /wallets/{uid} {
      allow read: if owns(uid);
      allow write: if false;
      match /entries/{entryId} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
    }
    match /feedback/{feedbackId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /supportRequests/{requestId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /emailOutbox/{jobId} { allow read, write: if false; }
    match /outbox/{eventId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
