{
  "expo": {
    "name": "OneBuddy",
    "slug": "onebuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121214",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onebuddy.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OneBuddy uses your location to find nearby stores and give accurate arrival times."
      }
    },
    "android": {
      "package": "com.onebuddy.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#121214"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {},
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OneBuddy uses your location to find nearby stores and give accurate arrival times."
        }
      ]
    ]
  }
}